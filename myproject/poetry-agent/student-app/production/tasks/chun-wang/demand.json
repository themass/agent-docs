{
  "poem": "chun-wang",
  "title": "春望(杜甫)",
  "bundle": "../runtime/contracts/sample.chun-wang.json",
  "bundle_note": "只读引用任务 B 的样例 bundle。台词文本一律从这里取(text_from),素材任务不另写文案;文案变了,gen 会提示任务单过期。",
  "poem_lines": [
    {
      "seq": 1,
      "text": "国破山河在"
    },
    {
      "seq": 2,
      "text": "城春草木深"
    },
    {
      "seq": 3,
      "text": "感时花溅泪"
    },
    {
      "seq": 4,
      "text": "恨别鸟惊心"
    },
    {
      "seq": 5,
      "text": "烽火连三月"
    },
    {
      "seq": 6,
      "text": "家书抵万金"
    },
    {
      "seq": 7,
      "text": "白头搔更短"
    },
    {
      "seq": 8,
      "text": "浑欲不胜簪"
    }
  ],
  "poem_lines_note": "line_seq 以 facts.chun-wang.json 为准(1..8,每句一行)。原文与字音未与纸质课本核对,见 holds.text。",
