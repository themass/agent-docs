  "textVersionId": "text-chun-wang-draft",
  "lines": [
    {
      "seq": 1,
      "text": "国破山河在，",
      "pinyin": null
    },
    {
      "seq": 2,
      "text": "城春草木深。",
      "pinyin": null
    },
    {
      "seq": 3,
      "text": "感时花溅泪，",
      "pinyin": null
    },
    {
      "seq": 4,
      "text": "恨别鸟惊心。",
      "pinyin": null
    },
    {
      "seq": 5,
      "text": "烽火连三月，",
      "pinyin": null
    },
    {
      "seq": 6,
      "text": "家书抵万金。",
      "pinyin": null
    },
    {
      "seq": 7,
      "text": "白头搔更短，",
      "pinyin": null
    },
    {
      "seq": 8,
      "text": "浑欲不胜簪。",
      "pinyin": null
    }
  ],
  "annotations": [
    {
      "id": "ann-chun-wang-shanhe",
      "lineSeq": 1,
      "kind": "WORD",
      "text": "山河：山和河，指大地山川。"
    },
    {
      "id": "ann-chun-wang-fenghuo",
      "lineSeq": 5,
      "kind": "WORD",
      "text": "烽火：战火，这里指战事。"
    }
  ],
