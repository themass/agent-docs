 "lines": [
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 1,
   "content": "国破山河在，",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 2,
   "content": "城春草木深。",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 3,
   "content": "感时花溅泪，",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 4,
   "content": "恨别鸟惊心。",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 5,
   "content": "烽火连三月，",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 6,
   "content": "家书抵万金。",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 7,
   "content": "白头搔更短，",
   "pinyin": null
  },
  {
   "version_id": "text-chun-wang-draft",
   "line_seq": 8,
   "content": "浑欲不胜簪。",
   "pinyin": null
  }
 ],
