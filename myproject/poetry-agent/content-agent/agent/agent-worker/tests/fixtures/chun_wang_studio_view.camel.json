  "lines": [
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 1,
    "content": "国破山河在，",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 2,
    "content": "城春草木深。",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 3,
    "content": "感时花溅泪，",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 4,
    "content": "恨别鸟惊心。",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 5,
    "content": "烽火连三月，",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 6,
    "content": "家书抵万金。",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 7,
    "content": "白头搔更短，",
    "pinyin": null
   },
   {
    "versionId": "text-chun-wang-draft",
    "lineSeq": 8,
    "content": "浑欲不胜簪。",
    "pinyin": null
   }
  ],
