{
  "middlewares": [],
  "mcpInterceptors": [],
  "mcpServers": {
    "poetry-domain": {
      "enabled": true,
      "type": "http",
      "url": "http://poetry-domain-mcp:8101/mcp",
      "headers": {
        "Authorization": "$POETRY_DOMAIN_MCP_AUTHORIZATION"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 30,
      "tool_call_timeout": 30,
      "description": "Poetry Java API boundary. Read canonical content snapshots and integrity gap reports. Read-only for the authoring agent.",
      "capability": {
        "id": "poetry-domain-mcp-v1"
      }
    }
  },
  "skills": {
    "authoring-orchestrator": {
      "enabled": true
    },
    "poem-gap-analysis": {
      "enabled": true
    },
    "annotation-design": {
      "enabled": true
    },
    "scene-script-draft": {
      "enabled": true
    },
    "compile-triage": {
      "enabled": true
    },
    "content-review": {
      "enabled": true
    }
  }
}
