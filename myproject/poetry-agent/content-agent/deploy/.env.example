# External system boundary. The Java Poetry API remains the fact owner.
POETRY_API_BASE_URL=http://host.docker.internal:8080
POETRY_API_TIMEOUT_SECONDS=15

# Internal service endpoints
AGENT_BFF_PORT=8100
POETRY_DOMAIN_MCP_PORT=8101
# 发布到宿主机的端口绑定地址。默认只监听回环;需要局域网访问时才改成 0.0.0.0。
AGENT_BIND_HOST=127.0.0.1
# DEERFLOW_ENABLED: BFF 只用它给 run 标 DEERFLOW / STUB; worker 用它决定是否真的调用网关。
DEERFLOW_ENABLED=false
# 以下三项只给 agent-worker(BFF 不再访问网关)。
DEERFLOW_GATEWAY_URL=http://deerflow-gateway:8001
DEERFLOW_ASSISTANT_ID=poetry-editor-lead
# 网关用 X-DeerFlow-Internal-Token 校验调用方,值必须等于下面的 DEER_FLOW_INTERNAL_AUTH_TOKEN。
# 留空则 compose 自动沿用 DEER_FLOW_INTERNAL_AUTH_TOKEN。
DEERFLOW_GATEWAY_TOKEN=
WORKER_MAX_CONCURRENT_RUNS=2

# Development only. Replace with platform-issued credentials in staging/prod.
POETRY_AGENT_INTERNAL_TOKEN=change-me
# Shared only by DeerFlow Gateway and the internal Poetry Domain MCP service.
POETRY_DOMAIN_MCP_TOKEN=change-me-mcp-token
# 持有者: agent-bff、agent-worker、poetry-domain-mcp。DeerFlow 网关不得持有。
POETRY_DOMAIN_CONTROL_TOKEN=change-me-domain-control-token
# 评审/应用专用。worker 不持有它，所以 agent 造出的提案无法被自己批准（A-05）。
# 必须与 control 令牌不同值；留空或不设时评审路由直接 503。
POETRY_DOMAIN_REVIEW_TOKEN=change-me-domain-review-token
POETRY_AGENT_ACTOR_ROLE=CONTENT_EDITOR

# Image references. DeerFlow is deployed as a separate runtime, never vendored here.
DEERFLOW_VERSION=2.2.0
# DeerFlow publishes its runtime as a source-built Compose stack; use the pinned official release checkout.
# Resolved relative to this directory (content-agent/deploy/); the pinned checkout lives in ./upstream.
DEERFLOW_SOURCE_DIR=./upstream/deer-flow-v2.2.0
# Gateway credentials required by DeerFlow 2.2 when enabled.
DEER_FLOW_INTERNAL_AUTH_TOKEN=change-me-deerflow-internal
DEER_FLOW_CREDENTIALS_KEY=change-me-deerflow-credentials

# ---------------------------------------------------------------------------
# Studio / worker 令牌(A-contract §2、§14)
# ---------------------------------------------------------------------------
# BFF → agent-worker 的派发令牌。持有者: agent-bff、agent-worker。
POETRY_WORKER_TOKEN=change-me-worker-token
# BFF → Java studio 人类写入口(填 locator、核验来源、逐项评审)。
# 持有者: 仅 agent-bff 与 Java。绝不能出现在 MCP、worker、DeerFlow 的环境里。
POETRY_STUDIO_REVIEWER_TOKEN=change-me-studio-reviewer-token
# Studio 前端的来源白名单(CORS),逗号分隔。
# Studio 登录: required(默认)= 必须登录; off = 仅离线演示,身份由请求自己声明,生产环境绝不能用。
POETRY_STUDIO_AUTH=required
# 会话令牌的签名密钥,至少 32 字符;以 change-me 开头的占位值会被 BFF 拒绝。持有者: 仅 agent-bff。
# 由 scripts/content-agent/env-sync.sh 生成随机值。
POETRY_STUDIO_SESSION_SECRET=change-me-studio-session-secret-replace-before-use
POETRY_STUDIO_ORIGINS=http://localhost:5190,http://127.0.0.1:5190

# ---------------------------------------------------------------------------
# 模型网关(OpenAI 兼容,明文 http)。仅 deerflow-gateway 使用。
# 由 scripts/maintenance/sync_llm_env.py 管理: 不要手工填写,也不要提交真实值。
# ---------------------------------------------------------------------------
POETRY_LLM_API_BASE=
POETRY_LLM_API_KEY=
POETRY_LLM_MODEL_PRIMARY=
POETRY_LLM_MODEL_FALLBACK=
