# JC API — FastAPI + embedded DeerFlow agent.
#
# Install:
#   sudo cp deploy/systemd/jc-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jc-api
#
# Edit WorkingDirectory, User and the venv path to match the deploy host.
# Nothing here is secret: credentials live in backend/server/.env, which
# EnvironmentFile loads at start.
[Unit]
Description=JC API (FastAPI + DeerFlow agent)
After=network-online.target mysql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=jc
Group=jc
WorkingDirectory=/opt/jc/backend/server
EnvironmentFile=/opt/jc/backend/server/.env

# 8000 must match the jc_api upstream in the Nginx conf. 127.0.0.1 only:
# Nginx is the single public listener, and binding 0.0.0.0 would expose the
# API without the limits and headers the proxy adds.
#
# --proxy-headers with a loopback allow-list: the app reads X-Forwarded-Proto
# to decide whether a Secure cookie is permitted. Without it every request
# looks like plain http and https logins silently fail. The allow-list keeps
# a direct caller from forging the header.
ExecStart=/opt/jc/backend/server/.venv/bin/python -m uvicorn jc.main:app \
    --app-dir /opt/jc/backend/server/src \
    --host 127.0.0.1 --port 8000 \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=5
# SSE preview streams run up to 240s; a shorter stop timeout would cut live
# responses on every deploy.
TimeoutStopSec=300
KillSignal=SIGINT

StandardOutput=append:/opt/jc/.data/logs/production/api.log
StandardError=append:/opt/jc/.data/logs/production/api.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The app writes uploads, exports and logs under .data/.
ReadWritePaths=/opt/jc/.data

[Install]
WantedBy=multi-user.target
