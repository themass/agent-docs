# JC Web — Next.js production server.
#
# Install:
#   sudo cp deploy/systemd/jc-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now jc-web
#
# This serves a build, it does not make one. Run
# `./scripts/start-production.sh --build-only` before the first start and
# before every restart that follows a code change — `next start` on a stale
# .next silently serves the previous release.
[Unit]
Description=JC Web (Next.js)
After=network-online.target jc-api.service
Wants=network-online.target

[Service]
Type=simple
User=jc
Group=jc
WorkingDirectory=/opt/jc/frontend/web

# NEXT_PUBLIC_SITE_URL is deliberately absent: it is a build-time variable
# compiled into the client bundle, so setting it here would change nothing and
# invite the belief that a restart is enough to change the domain. It lives in
# frontend/web/.env.production and takes effect at `npm run build`.
Environment=NODE_ENV=production
Environment=PORT=3000
# Nginx routes /api/v1 straight to the API so this rewrite is normally unused.
# Pointed at the right port anyway: if it ever is hit, a silent proxy to the
# dev default 8001 is much harder to diagnose than a 502.
Environment=JC_API_PROXY_TARGET=http://127.0.0.1:8000

ExecStart=/usr/bin/npm run start

Restart=always
RestartSec=5
TimeoutStopSec=30

StandardOutput=append:/opt/jc/.data/logs/production/web.log
StandardError=append:/opt/jc/.data/logs/production/web.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Next writes its build cache and server output under .next at runtime.
ReadWritePaths=/opt/jc/frontend/web/.next /opt/jc/.data

[Install]
WantedBy=multi-user.target
