{
  "middlewares": [
    "jobcome.deerflow_middleware:JobComeProductRulesMiddleware"
  ],
  "mcpInterceptors": [
    "jobcome.mcp.interceptors:build_apply_pipeline_review_interceptor"
  ],
  "mcpServers": {
    "jobcome": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": ["-m", "jobcome.mcp.server"],
      "env": {
        "JOB_COME_MCP_USER_ID": "$JOB_COME_MCP_USER_ID",
        "JOB_COME_MCP_PROFILE_ID": "$JOB_COME_MCP_PROFILE_ID",
        "JOB_COME_MCP_JOB_ID": "$JOB_COME_MCP_JOB_ID",
        "JOB_COME_MCP_SESSION_ID": "$JOB_COME_MCP_SESSION_ID"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 120,
      "description": "JobCome business tools: profile, interview bank, JD fit",
      "routing": {
        "mode": "prefer",
        "priority": 100,
        "keywords": ["简历", "档案", "profile", "面试", "题库", "JD", "岗位", "匹配"]
      }
    }
  },
  "skills": {
    "resume-coach": { "enabled": true },
    "resume-writer": { "enabled": true },
    "resume-reviewer": { "enabled": true },
    "coach-mock": { "enabled": true },
    "coach-answer": { "enabled": true },
    "coach-archive": { "enabled": true },
    "jd-parser": { "enabled": true },
    "apply-pipeline": { "enabled": true }
  }
}
