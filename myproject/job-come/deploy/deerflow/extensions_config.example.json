{
  "middlewares": [],
  "mcpInterceptors": [],
  "mcpServers": {
    "jobcome": {
      "enabled": true,
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "jobcome.mcp.server"],
      "env": {
        "JOB_COME_MCP_USER_ID": "${user_id}",
        "JOB_COME_MCP_PROFILE_ID": "${profile_id}"
      },
      "tool_name_prefix": true,
      "session_init_timeout": 60,
      "tool_call_timeout": 120,
      "description": "JobCome business tools: profile, interview bank, JD fit",
      "routing": {
        "mode": "prefer",
        "priority": 100,
        "keywords": ["简历", "档案", "profile", "面试", "题库", "JD", "岗位", "匹配"]
      }
    },
    "markitdown": {
      "enabled": false,
      "type": "stdio",
      "command": "uv",
      "args": ["run", "markitdown-mcp"],
      "description": "Microsoft MarkItDown — PDF/DOCX/PPTX to markdown",
      "routing": {
        "mode": "prefer",
        "priority": 50,
        "keywords": ["pdf", "docx", "parse", "upload", "convert"]
      }
    },
    "fetch": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"],
      "description": "Fetch public JD URL to markdown (no API key)",
      "routing": {
        "mode": "prefer",
        "priority": 40,
        "keywords": ["url", "fetch", "http", "招聘链接"]
      }
    },
    "tavily": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp@latest"],
      "env": { "TAVILY_API_KEY": "${TAVILY_API_KEY}" },
      "description": "Company research & public JD discovery",
      "routing": {
        "mode": "prefer",
        "priority": 30,
        "keywords": ["公司调研", "research", "search", "JD"]
      }
    },
    "brave-search": {
      "enabled": false,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": { "BRAVE_API_KEY": "${BRAVE_API_KEY}" },
      "description": "Brave web search fallback",
      "routing": {
        "mode": "prefer",
        "priority": 25,
        "keywords": ["search", "news", "company"]
      }
    },
    "boss-agent": {
      "enabled": false,
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "boss-agent-cli[mcp]", "boss-mcp"],
      "description": "CN job discovery (BOSS/智联) — READ-ONLY assist, no auto-apply",
      "routing": {
        "mode": "prefer",
        "priority": 20,
        "keywords": ["BOSS", "智联", "岗位搜索", "招聘"]
      }
    }
  },
  "skills": {
    "resume-coach": { "enabled": true },
    "resume-writer": { "enabled": true },
    "resume-reviewer": { "enabled": true },
    "coach-mock": { "enabled": true },
    "coach-answer": { "enabled": true },
    "coach-archive": { "enabled": true },
    "jd-parser": { "enabled": true },
    "apply-pipeline": { "enabled": true }
  }
}
