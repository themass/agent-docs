# JobCome — copy to .env and fill in (never commit .env)

# App
JOB_COME_ENV=development
JOB_COME_PUBLIC_URL=https://job.sspacee.com
JOB_COME_API_PREFIX=/api/v1
JOB_COME_DOCS_ENABLED=true

# MySQL (database: vpn)
JOB_COME_DB_HOST=mysql.sspacee.com
JOB_COME_DB_PORT=6666
JOB_COME_DB_NAME=vpn
JOB_COME_DB_USER=
JOB_COME_DB_PASSWORD=
# mysql+aiomysql://user:pass@host:port/vpn?charset=utf8mb4

# Redis (session, rate limit, ARQ)
JOB_COME_REDIS_URL=redis://127.0.0.1:6379/0

# Object storage — Volcengine TOS (S3-compatible API), region: Beijing
JOB_COME_S3_PROVIDER=volcengine_tos
JOB_COME_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
JOB_COME_S3_BUCKET=sspacee
JOB_COME_S3_REGION=cn-beijing
JOB_COME_S3_ACCESS_KEY=
JOB_COME_S3_SECRET_KEY=
# TOS S3 API requires virtual-hosted style (not path-style)
JOB_COME_S3_FORCE_PATH_STYLE=false

# CDN — leave SIGN_KEY empty to use TOS presigned URLs (方案 A，备案前推荐)
JOB_COME_CDN_DOMAIN=https://files.job.sspacee.com
JOB_COME_CDN_SIGN_KEY=
JOB_COME_DOWNLOAD_URL_TTL_SEC=900
# Local object store when TOS AK/SK empty (dev only)
JOB_COME_STORAGE_LOCAL_DIR=.data/objects

# LLM — REQUIRED for real resume parse & elevate (without this you get placeholder data)
JOB_COME_LLM_ENABLED=true
JOB_COME_LLM_ROUTING_PATH=deploy/llm/routing.yaml
JOB_COME_LLM_MODEL_FAST=jobcome-fast
JOB_COME_LLM_MODEL_VISION=jobcome-vision
YUAI_API_BASE=https://newapi.yuaiweiwu.com/v1
YUAI_API_KEY=
# Vision / OCR — separate route (can use different vendor later)
YUAI_VISION_API_BASE=https://newapi.yuaiweiwu.com/v1
YUAI_VISION_API_KEY=
YUAI_VISION_MODEL=qwen-vl-ocr
OPENAI_API_BASE=http://127.0.0.1:4000/v1
OPENAI_API_KEY=sk-litellm-local
LITELLM_MASTER_KEY=sk-litellm-local
# Text: jobcome-fast/writer → bt-deepseek-v4-pro; coach → bt-gpt-5-5
# Vision: jobcome-vision → qwen-vl-ocr (YUAI_VISION_*)

# Session cookies (SECURE=false for local http dev)
JOB_COME_COOKIE_SECURE=false
JOB_COME_SESSION_TTL_DAYS=7
JOB_COME_GUEST_TTL_DAYS=30

# Email (password reset) — QQ: smtp.qq.com:465 + SMTP 授权码（不是 QQ 登录密码）
JOB_COME_SMTP_HOST=smtp.qq.com
JOB_COME_SMTP_PORT=465
JOB_COME_SMTP_USE_SSL=true
JOB_COME_SMTP_USER=
JOB_COME_SMTP_PASSWORD=
JOB_COME_EMAIL_FROM=
JOB_COME_PASSWORD_RESET_TTL_HOURS=1
JOB_COME_EMAIL_VERIFY_TTL_HOURS=48

# Langfuse Cloud — LLM trace UI (JobCome API + DeerFlow Agent loop)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# US region: https://us.cloud.langfuse.com  |  EU: https://cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Required for DeerFlow harness LangChain callbacks (skill/tool/LLM spans)
LANGFUSE_TRACING=true

# Trace
JOB_COME_DEBUG_CONTEXT_USAGE=false
# Admin session audit UI — enabled automatically in JOB_COME_ENV=development
JOB_COME_ADMIN_ENABLED=false
JOB_COME_ADMIN_TOKEN=
JOB_COME_CONTEXT_TOKEN_LIMIT=200000
JOB_COME_SUMMARIZATION_TRIGGER_TOKENS=32000
JOB_COME_SUMMARIZATION_KEEP_MESSAGES=10
# Demo seed: python scripts/seed_demo.py
# JOB_COME_DEMO_EMAIL=demo@jobcome.local
# JOB_COME_DEMO_PASSWORD=Demo1234!
# NEXT_PUBLIC_DEBUG_CONTEXT_USAGE=false  # apps/web/.env.local

# E2E smoke (scripts/e2e_smoke.sh)
# JOB_COME_E2E_BASE=http://127.0.0.1:8000/api/v1
# JOB_COME_E2E_EMAIL=
# DeerFlow — vendor at ../libs/agentkit/vendor/deer-flow (sync: scripts/sync-deerflow-upstream.sh)
JOB_COME_DEERFLOW_CONFIG_PATH=deploy/deerflow/config.yaml
JOB_COME_DEERFLOW_CHECKPOINT_BACKEND=sqlite
JOB_COME_DEERFLOW_CHECKPOINT_SQLITE_PATH=.data/deerflow/checkpoints.sqlite3
JOB_COME_DEERFLOW_EXTENSIONS_CONFIG=deploy/deerflow/extensions_config.json
JOB_COME_SKILLS_ROOT=skills
