# Public site URL for canonical links, sitemap, Open Graph.
#
# Dev needs nothing: `lib/seo/site.ts` falls back to http://localhost:3000.
# Production is committed in `.env.production` — override here only to point a
# staging build at a different host.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: show admin session audit link in agent header (dev only by default).
# NEXT_PUBLIC_JC_DEV_TOOLS=true
