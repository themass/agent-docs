# Public site URL for canonical links, sitemap, Open Graph.
#
# Dev needs nothing: `lib/seo/site.ts` falls back to http://localhost:3000.
# Production is committed in `.env.production` — override here only to point a
# staging build at a different host.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: show admin session audit link in agent header (dev only by default).
# NEXT_PUBLIC_JC_DEV_TOOLS=true

# Search-engine verification tokens. Leave unset and the tags are simply not emitted
# (lib/seo/verification.ts filters empties), so this file documents the whole surface.
# GSC: prefer the DNS "网域" property (covers http+https at once); the tag below is the
# file/HTML alternative. Values come from Search Console / 百度搜索资源平台 / Bing WMT.
# NEXT_PUBLIC_GSC_SITE_VERIFICATION=
# NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# Analytics (optional, self-hosted Plausible-style). Unset = no third-party script at
# all. This is separate from AdSense, which stays behind its own consent gate.
# NEXT_PUBLIC_ANALYTICS_SRC=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
