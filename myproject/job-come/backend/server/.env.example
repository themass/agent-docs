# JC — copy to .env and fill in (never commit .env)

# App
JC_ENV=development
JC_PUBLIC_URL=http://jc.sspacee.com
JC_API_PREFIX=/api/v1
JC_DOCS_ENABLED=true

# Postgres — the only database. Holds both the business tables and the
# LangGraph checkpoint tables.
# The driver must be async: `postgresql+psycopg://`. A bare `postgresql://`
# resolves psycopg2 and cannot drive the async session.
JC_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/job_come
# Fail quickly and recycle idle pooled connections.
JC_DB_CONNECT_TIMEOUT_SECONDS=10
JC_DB_POOL_RECYCLE_SECONDS=900
JC_DB_POOL_TIMEOUT_SECONDS=10

# Redis (all keys must use jc:{environment}: namespace)
JC_REDIS_URL=redis://127.0.0.1:6379/0
JC_REDIS_KEY_PREFIX=jc:dev:

# Object storage — Volcengine TOS (S3-compatible API), region: Beijing
JC_S3_PROVIDER=volcengine_tos
JC_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
JC_S3_BUCKET=sspacee
JC_S3_REGION=cn-beijing
JC_S3_ACCESS_KEY=
JC_S3_SECRET_KEY=
# TOS S3 API requires virtual-hosted style (not path-style)
JC_S3_FORCE_PATH_STYLE=false

# CDN — leave SIGN_KEY empty to use TOS presigned URLs (方案 A，备案前推荐)
JC_CDN_DOMAIN=https://files.job.sspacee.com
JC_CDN_SIGN_KEY=
JC_DOWNLOAD_URL_TTL_SEC=900
# Local object store when TOS AK/SK empty (dev only)
JC_STORAGE_LOCAL_DIR=.data/objects

# LLM — REQUIRED for real resume parse & elevate (without this you get placeholder data)
JC_LLM_ENABLED=true
JC_LLM_ROUTING_PATH=../agent/llm/routing.yaml
# http, not https: the gateway answers 443 with a self-signed certificate that
# litellm refuses at the TLS handshake, so every chain fails before a request
# is sent. Switch back once the gateway has a real certificate.
JC_LLM_API_BASE=http://gpt.sspacee.com/v1
JC_LLM_API_KEY=
# Vision / OCR — PDF 转图、jpg/png；未填则回退 JC_LLM_*
JC_LLM_VISION_API_BASE=http://gpt.sspacee.com/v1
JC_LLM_VISION_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 模型链 —— 换模型的唯一入口
#
# 每个场景一行，逗号分隔，按顺序失败转移：第一个是主力，后面是后备。
# 留空 = 用 backend/agent/llm/routing.yaml 里提交的默认值，所以不配也能跑。
#
# 只换模型名写这里；超时、reasoning、max_tokens 这些调优仍在 routing.yaml
# （那些值是按网关实测定的，不是猜的 —— vision 的输出上限超了会被网关直接拒）。
#
# 场景           谁在用
#   coach        舟卡主对话、模拟面试官（session 角色的默认）
#   writer       简历生成与改写
#   reviewer     面试评审（独立于面试官，避免自评）
#   flash        轻量单次调用：匹配打分、本地化、追问判定、简历评审
#   ingest_fast  简历/JD 结构化抽取（关闭 thinking，只要 JSON）
#   vision       PDF 转图、截图 OCR
#
# 网关要求 `openai/` 前缀（litellm 靠它选适配器），去掉前缀会当成别家的模型。
# ─────────────────────────────────────────────────────────────────────────────
# 主力：gpt-6-luna（125 tok/s，能读图）；后备：glm-5.3-flash
JC_LLM_MODEL_COACH=openai/gpt-6-luna,openai/glm-5.3-flash
JC_LLM_MODEL_WRITER=openai/gpt-6-luna,openai/glm-5.3-flash
JC_LLM_MODEL_REVIEWER=openai/gpt-6-luna,openai/glm-5.3-flash
JC_LLM_MODEL_FLASH=openai/glm-5.3-flash,openai/gpt-6-luna
# 抽取只要 JSON，不要思考过程；thinking 已在 routing.yaml 关掉
JC_LLM_MODEL_INGEST_FAST=openai/glm-5.3-flash,openai/gpt-6-luna
# OCR 主用 Qwen-VL；luna 是后备通用模型（deepseek 系拒图，不能顶班）
JC_LLM_MODEL_VISION=openai/qwen3-vl-plus,openai/gpt-6-luna
# LLM call audit log (jc_llm_call / jc_llm_call_attempt)
JC_LLM_LOG_ENABLED=true
# prompt/响应/思考原文含简历个人信息。关掉仍保留指标、真实模型与失败码。
#
# 生产取值已定：开。理由是「这版简历为什么写成这样」只能从原文回答——
# 用户投诉某段措辞、或要查某个指标是模型编的还是用户自己给的，看 token 数是看不出来的。
# 代价用时间窗口抵掉，而不是关掉开关：原文只留 14 天，之后由 cron 清掉但保留
# 成本与可靠性指标（见下方 crontab 示例与 docs/operations/OPS-DEPLOYMENT.md）。
JC_LLM_LOG_PAYLOAD=true
JC_LLM_LOG_PAYLOAD_MAX_CHARS=60000
# 留存窗口，由 scripts/prune_llm_log.py 执行
JC_LLM_LOG_RETENTION_DAYS=90
# 原文（prompt/响应/思考）单独的、更短的窗口，由 scripts/prune_llm_log.sh 读取。
# 比整行窗口短是刻意的：指标留着看趋势，个人信息早点清掉。
JC_LLM_LOG_PAYLOAD_DAYS=14
#
# 生产必须配这条 cron，否则上面的「开」就变成了无限期保存简历原文：
#   17 4 * * *  cd /srv/jc && ./scripts/prune_llm_log.sh >> /var/log/jc/prune.log 2>&1

# PII redaction（DeerFlow pii_redaction middleware，默认关）
# 只处理正则可识别的邮箱/手机号/身份证号/信用卡号/API key，不处理姓名、公司名
# （无法用正则判定）。开启后这些字段进大模型请求前被替换成 HMAC 占位符；
# 数据库和前端 UI 仍是原文，jc_llm_call 记录的也是占位符后的版本。
# JC_PII_REDACTION_TOKEN_SECRET 必须 >=16 字符，开启时留空会在启动时报错。
JC_PII_REDACTION_ENABLED=true
JC_PII_REDACTION_TOKEN_SECRET=

# 单次 agent run 的硬性 token 上限（DeerFlow token_budget middleware）。
# 超限直接强制停止，防止 prompt 设计问题或工具调用不收敛导致的失控成本。
JC_TOKEN_BUDGET_ENABLED=true
# 与 JC_MODEL_CONTEXT_WINDOW / JC_CONTEXT_TOKEN_LIMIT 对齐到 200k：低于上下文窗口时，
# 一轮尚未填满窗口的对话会被预算先掐断，表现为 agent 中途停止而不是上下文超限。
JC_TOKEN_BUDGET_MAX_TOKENS=200000

# Optional extra providers (reference from routing.yaml providers.*)
# JC_LLM_ALT_API_BASE=https://other-gateway.example/v1
# JC_LLM_ALT_API_KEY=
# JC_LLM_ANTHROPIC_API_BASE=
# JC_LLM_ANTHROPIC_API_KEY=
# 模型 slug 见 backend/agent/llm/routing.yaml（与网关控制台一致）

# Session cookies (SECURE=false for local http dev)
JC_COOKIE_SECURE=false
JC_SESSION_TTL_DAYS=7
JC_GUEST_TTL_DAYS=30

# Email (password reset) — QQ: smtp.qq.com:465 + SMTP 授权码（不是 QQ 登录密码）
JC_SMTP_HOST=smtp.qq.com
JC_SMTP_PORT=465
JC_SMTP_USE_SSL=true
JC_SMTP_USER=
JC_SMTP_PASSWORD=
JC_EMAIL_FROM=
JC_PASSWORD_RESET_TTL_HOURS=1
JC_EMAIL_VERIFY_TTL_HOURS=48
JC_EMAIL_VERIFY_MAX_ATTEMPTS=5

# Langfuse Cloud — LLM trace UI (JC API + DeerFlow Agent loop)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# US region: https://us.cloud.langfuse.com  |  EU: https://cloud.langfuse.com
LANGFUSE_HOST=https://us.cloud.langfuse.com
# Required for DeerFlow harness LangChain callbacks (skill/tool/LLM spans)
LANGFUSE_TRACING=true

# Trace
JC_DEBUG_CONTEXT_USAGE=false
# Admin session audit UI — enabled automatically in JC_ENV=development
JC_ADMIN_ENABLED=false
JC_ADMIN_TOKEN=
JC_CONTEXT_TOKEN_LIMIT=200000
JC_SUMMARIZATION_TRIGGER_TOKENS=32000
JC_SUMMARIZATION_KEEP_MESSAGES=10
# Demo seed: python scripts/seed_demo.py
# JC_DEMO_EMAIL=demo@jc.local
# JC_DEMO_PASSWORD=Demo1234!
# NEXT_PUBLIC_DEBUG_CONTEXT_USAGE=false  # frontend/web/.env.local

# E2E smoke (scripts/e2e_smoke.sh)
# JC_E2E_BASE=http://127.0.0.1:8000/api/v1
# JC_E2E_EMAIL=
# DeerFlow — vendor at ../libs/agentkit/vendor/deer-flow (sync: scripts/sync-deerflow-upstream.sh)
JC_DEERFLOW_CONFIG_PATH=../agent/deerflow/config.yaml
# `postgres` keeps conversation history in the same database as the business
# tables (JC_DEERFLOW_CHECKPOINT_POSTGRES_URL empty = reuse JC_DATABASE_URL).
# `sqlite` is the developer-box default; it cannot be shared between processes.
JC_DEERFLOW_CHECKPOINT_BACKEND=sqlite
JC_DEERFLOW_CHECKPOINT_SQLITE_PATH=.data/deerflow/checkpoints.sqlite3
# JC_DEERFLOW_CHECKPOINT_POSTGRES_URL=postgresql+psycopg://user:pass@host:5432/job_come
# Generated DeerFlow session/skill-projection state; do not point to .deer-flow.
JC_DEERFLOW_RUNTIME_HOME=.data/deerflow/runtime
JC_DEERFLOW_EXTENSIONS_CONFIG=../agent/deerflow/extensions_config.json
JC_SKILLS_ROOT=../agent/skills

# 生成后的定向修复：blueprint/structure/coverage 测出明显缺口时，只重写出问题的那几段一次。
# 只有在重写后确实变好、且没有引入档案不支持的说法时才采纳；否则保留第一稿。
# 写手链失败（generation.mode=source_layout）时不触发——那是重试一条已经失败的链路。
# 设为 false 可在不发版的情况下关掉，回到单次生成。
JC_PREVIEW_REPAIR_ENABLED=true
# 修复自己的预算，不从 JC_PREVIEW_WRITER_TIMEOUT_SECONDS 里切：首轮要产出整篇文档。
# 最坏总耗时 90+40=130 秒，仍低于 SSE 的 240 秒与前端的 255 秒。最大60秒。
JC_PREVIEW_REPAIR_TIMEOUT_SECONDS=40

# 导出质检的等待预算在 backend/agent/roles.yaml 的 resume-reviewer 中声明（timeout_seconds）。

# 上传解析统一总预算：本地提取 + 模型回退共享，不因换路线重新计时。
JC_INGEST_TIMEOUT_SECONDS=90
# 文本流的连接/读空闲上限（不是完整生成时长）；视觉模型仍为单请求超时。
JC_INGEST_ATTEMPT_TIMEOUT_SECONDS=25

# 单个文本模型从连接到完整 JSON 的生成预算，与上面的读空闲预算分离。
# 单模型完整结构化流限制 30 秒；全链路总预算 90 秒，不会按模型重复叠加。
JC_INGEST_STREAM_ATTEMPT_SECONDS=30
# Multi-instance database claim lease for profile parse workers.
JC_PROFILE_PARSE_LEASE_SECONDS=240
JC_PROFILE_PARSE_CONCURRENCY=2
