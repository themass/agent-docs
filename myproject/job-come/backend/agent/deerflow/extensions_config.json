{
  "middlewares": [
    "jc.deerflow_middleware:JCProductRulesMiddleware"
  ],
  "mcpInterceptors": [
    "jc.mcp.identity_interceptor:build_jc_identity_interceptor",
    "jc.mcp.interceptors:build_apply_pipeline_review_interceptor"
  ],
  "mcpServers": {
    "jc": {
      "enabled": true,
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "jc.mcp.server"
      ],
      "tool_name_prefix": false,
      "session_init_timeout": 60,
      "tool_call_timeout": 120,
      "description": "JC business tools: profile, interview bank, JD fit",
      "routing": {
        "mode": "prefer",
        "priority": 100,
        "keywords": [
          "简历",
          "档案",
          "profile",
          "面试",
          "题库",
          "JD",
          "岗位",
          "匹配"
        ]
      }
    }
  },
  "skills": {
    "resume-coach": {
      "enabled": true
    },
    "profile-interview": {
      "enabled": true
    },
    "resume-writer": {
      "enabled": true
    },
    "resume-reviewer": {
      "enabled": true
    },
    "coach-mock": {
      "enabled": true
    },
    "coach-answer": {
      "enabled": true
    },
    "coach-archive": {
      "enabled": true
    },
    "jd-parser": {
      "enabled": true
    },
    "apply-pipeline": {
      "enabled": true
    }
  }
}
