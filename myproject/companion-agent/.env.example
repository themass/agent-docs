# companion-agent 环境变量。只放变量名与占位值；真实值写入本地 .env（不入库）。

COMPANION_ENV=dev
COMPANION_LOG_LEVEL=INFO

# 模型路由
COMPANION_LLM_ROUTING_PATH=config/llm/routing.yaml
COMPANION_LLM_API_BASE=
COMPANION_LLM_API_KEY=

# LiveKit Cloud（不自建）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 会话 token 有效期（秒）
COMPANION_TOKEN_TTL_SEC=600

# DeerFlow 主脑（嵌入式 harness）。config 路径为空时用 config/deerflow/config.yaml。
COMPANION_DEERFLOW_CONFIG=
COMPANION_CHAT_MODEL=openai/deepseek-v4-pro
COMPANION_UTILITY_MODEL=openai/deepseek-v4-flash
COMPANION_PII_REDACTION_ENABLED=false
COMPANION_PII_REDACTION_TOKEN_SECRET=

# 语音。第一版默认关闭：文字模式不需要任何语音供应商。
COMPANION_VOICE_ENABLED=false
COMPANION_VOICE_PROVIDER=volcengine
COMPANION_VOICE_ID=female_warm
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_ACCESS_TOKEN=
VOLCENGINE_ASR_APP_ID=
VOLCENGINE_ASR_ACCESS_TOKEN=

