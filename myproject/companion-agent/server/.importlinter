# 包结构契约。
#
# 提交前跑：PYTHONPATH=src .venv/bin/lint-imports
#
# 两层：agent（可复用的能力）与 service（这个产品的业务流程）。
# 依赖只允许 service -> agent，反过来一律禁止——agent 要能被别的产品直接用。

[importlinter]
root_package = companion
include_external_packages = True

# ---- agent 不得依赖 service ----
[importlinter:contract:agent-independent-of-service]
name = agent 不得依赖 service（agent 要能独立复用）
type = forbidden
source_modules = companion.agent
forbidden_modules = companion.service

# ---- agent 不得依赖接口层与组合根 ----
[importlinter:contract:agent-no-api]
name = agent 不得依赖 api 与 bootstrap
type = forbidden
source_modules = companion.agent
forbidden_modules =
    companion.api
    companion.bootstrap

# ---- agent 里只有 memory/sql 碰数据库 ----
[importlinter:contract:agent-parts-are-pure]
name = agent 的纯逻辑部分不得碰 I/O 与框架
type = forbidden
source_modules =
    companion.agent.prompt
    companion.agent.text
    companion.agent.lorebook
    companion.agent.middleware
    companion.agent.util
forbidden_modules =
    fastapi
    sqlalchemy
    redis
    httpx
    aiomysql
    pymysql
    livekit
    companion.db
    companion.service

# ---- db 是底座 ----
[importlinter:contract:db-is-foundational]
name = db 不依赖任何业务层
type = forbidden
source_modules = companion.db
forbidden_modules =
    companion.agent
    companion.service
    companion.api
    companion.bootstrap

# ---- service 不得依赖接口层 ----
[importlinter:contract:service-no-api]
name = service 不得依赖 api
type = forbidden
source_modules = companion.service
forbidden_modules =
    companion.api
    companion.bootstrap

# ---- 只有组合根与入口可以 import bootstrap ----
[importlinter:contract:only-bootstrap-wires]
name = 只有组合根与入口可以 import bootstrap
type = forbidden
source_modules =
    companion.agent
    companion.service
    companion.api
    companion.db
forbidden_modules = companion.bootstrap
