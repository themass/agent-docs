# companion-agent 环境变量。只放变量名与占位值；真实值写入本地 .env（不入库）。

COMPANION_ENV=dev
COMPANION_LOG_LEVEL=INFO

# 模型路由
COMPANION_LLM_ROUTING_PATH=config/llm/routing.yaml
COMPANION_LLM_API_BASE=
COMPANION_LLM_API_KEY=

# 场景模型链：逗号分隔、按顺序故障转移。换模型只改这里，routing.yaml 不用动
# （超时、推理强度等调优仍按位置对齐写在 routing.yaml）。
# 变量未设置 = 用 routing.yaml 里提交的默认模型。
#   场景名 = routing.yaml 里的场景，大写，前缀 COMPANION_LLM_MODEL_
COMPANION_LLM_MODEL_COMPANION_CHAT=
COMPANION_LLM_MODEL_MEMORY_EXTRACT=
COMPANION_LLM_MODEL_SESSION_SUMMARIZE=
COMPANION_LLM_MODEL_COMPANION_REWRITE=

# LiveKit Cloud（不自建）
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 会话 token 有效期（秒）
COMPANION_TOKEN_TTL_SEC=600

COMPANION_PII_REDACTION_ENABLED=false
COMPANION_PII_REDACTION_TOKEN_SECRET=

# 语音。第一版默认关闭：文字模式不需要任何语音供应商。
COMPANION_VOICE_ENABLED=false
COMPANION_VOICE_PROVIDER=volcengine
COMPANION_VOICE_ID=female_warm
VOLC_TTS_API_KEY=
VOLC_TTS_APP_ID=
VOLC_TTS_RESOURCE_ID=
VOLC_TTS_VOICE=
VOLC_ASR_API_KEY=

