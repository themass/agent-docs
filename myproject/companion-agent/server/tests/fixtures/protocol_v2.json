      ],
      "expect": [
        "accept",
        "duplicate"
      ]
    },
    {
      "name": "seq 倒退且 id 没见过：乱序，不是重复（开头的 3 已记一次 gap）",
      "ops": [
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 3,
          "id": "m3"
        },
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 1,
          "id": "m1"
