  "receiver": [
    {
      "name": "正常递增",
      "ops": [
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 0,
          "id": "m0"
        },
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 1,
          "id": "m1"
        },
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 2,
          "id": "m2"
        }
      ],
      "expect": [
        "accept",
        "accept",
        "accept"
      ]
    },
    {
      "name": "同一 id 重发被去重（F1）",
      "ops": [
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 0,
          "id": "m0"
        },
        {
