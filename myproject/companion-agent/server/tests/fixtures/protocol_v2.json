        "accept",
        "accept"
      ],
      "gaps": 1
    },
    {
      "name": "流的第一条不是 0：开头就断了，记一次 gap",
      "ops": [
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 5,
          "id": "m5"
        }
      ],
      "expect": [
        "accept"
      ],
      "gaps": 1
    },
    {
      "name": "gap 只按事件计数，不按丢了几条计数",
      "ops": [
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 0,
          "id": "m0"
        },
        {
          "publisher": "agent",
          "topic": "cmp.cue",
          "ep": "e1",
          "seq": 40,
          "id": "m40"
        }
      ],
      "expect": [
        "accept",
        "accept"
      ],
      "gaps": 1
    },
    {
      "name": "换了 epoch 就是新流，seq 归零不算倒退（F4）",
