[Unit]
Description=Companion voice worker (companion.worker, LiveKit agent)
Documentation=file:///home/web/webroot/companion-agent/README.md
After=network-online.target livekit.service
Wants=network-online.target

[Service]
Type=exec
User=web
Group=web
WorkingDirectory=/home/web/webroot/companion-agent/server
ExecStart=/home/web/webroot/companion-agent/scripts/run-as-service.sh voice
Restart=always
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65535
# 日志进 journal（journalctl -u companion-voice）。job 子进程（forkserver 派生）
# 继承本 unit 的 cgroup——livekit.service 的 CPUWeight=1000 因此能跨通话压住
# prewarm 风暴对 SFU 的干扰；本 unit 保持默认权重（通话内音频链不该被饿死）。

[Install]
WantedBy=multi-user.target
