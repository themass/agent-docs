{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "OpenAI Agents Session 记忆数据流",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [920, 400]
  },
  "stages": [
    { "label": "持久化" },
    { "label": "投影" },
    { "label": "消费" }
  ],
  "nodes": [
    { "id": "session", "type": "database", "label": "Session", "sublabel": "memory/session.py", "stage": 0, "row": 1 },
    { "id": "items", "type": "database", "label": "RunItem[]", "sublabel": "会话账本", "stage": 0, "row": 0 },
    { "id": "persist", "type": "backend", "label": "session_persistence", "sublabel": "append / rewind", "stage": 1, "row": 1 },
    { "id": "input", "type": "messagebus", "label": "TResponseInputItem", "sublabel": "LLM 输入", "stage": 1, "row": 0 },
    { "id": "runner", "type": "backend", "label": "Runner.run", "sublabel": "下次 run", "stage": 2, "row": 1 },
    { "id": "model", "type": "external", "label": "Model", "sublabel": "provider", "stage": 2, "row": 0 }
  ],
  "flows": [
    { "from": "items", "to": "session", "label": "append", "variant": "emphasis", "labelDy": 24 },
    { "from": "session", "to": "persist", "label": "load history" },
    { "from": "persist", "to": "input", "label": "投影", "variant": "emphasis" },
    { "from": "input", "to": "model", "label": "发给 LLM" },
    { "from": "runner", "to": "persist", "label": "run 前注入", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Session 账",
      "items": [
        "tool call/output 会持久化；下次 run 前注入 history",
        "optional trim 由 SessionSettings.limit 控制"
      ]
    }
  ]
}
