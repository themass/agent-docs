    { "id": "handle", "lane": "orch", "col": 1, "type": "backend", "label": "handle()", "sublabel": "Orchestrator" },
    { "id": "reg", "lane": "orch", "col": 2, "type": "cloud", "label": "Registry", "sublabel": "Capability" },
    { "id": "bus", "lane": "orch", "col": 3, "type": "messagebus", "label": "StreamBus", "sublabel": "扇出" },
    { "id": "run", "lane": "exec", "col": 4, "type": "backend", "label": "capability.run", "sublabel": "AgentLoop" },
    { "id": "done", "lane": "exec", "col": 5, "type": "external", "label": "RESULT", "sublabel": "DONE" }
