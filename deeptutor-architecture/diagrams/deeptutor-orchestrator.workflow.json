  "cards": [
    {
      "dot": "cyan",
      "title": "Agent-Native",
      "items": [
        "Capability 接管整轮执行，非 UI 换皮",
        "active_capability=None 时默认 chat"
      ]
    },
    {
      "dot": "violet",
      "title": "双引擎",
      "items": [
        "AgentLoop：narration / finish 语义",
        "run_agentic_loop：标签驱动第二引擎"
      ]
    }
  ]
