# --- ASR (Phase 1): domestic providers only for MVP ---

# Alibaba DashScope — Paraformer / fun-asr (recommended default)
# https://help.aliyun.com/zh/model-studio/developer-reference/paraformer-real-time-speech-recognition
DASHSCOPE_API_KEY=
SAYAGAIN_ASR_PROVIDER=dashscope
SAYAGAIN_ASR_MODEL=paraformer-v2

# ByteDance Volcengine — Doubao speech (alternative)
# VOLC_ACCESS_KEY=
# VOLC_SECRET_KEY=
# SAYAGAIN_ASR_PROVIDER=volcengine
# SAYAGAIN_ASR_MODEL=bigmodel

# --- Coach LLM (OpenAI-compatible; DashScope / Doubao) ---
SAYAGAIN_LLM_API_KEY=
SAYAGAIN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SAYAGAIN_LLM_MODEL=qwen-plus
