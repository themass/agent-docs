# LiveKit Cloud (required for inference / dev / start)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM mode: inference (default) | hermes
HERMES_COMPANION_LLM=inference
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini

# Hermes Gateway (when HERMES_COMPANION_LLM=hermes)
# Start: hermes gateway run  (API on :8642)
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=change-me-local-dev
HERMES_MODEL=hermes-agent

# Voice
HERMES_COMPANION_STT_LANG=zh
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_TTS_MODEL=cartesia/sonic-3
HERMES_COMPANION_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Hermes memory files (~/.hermes/memories/USER.md, MEMORY.md)
# HERMES_AGENT_DIR=/Users/you/.hermes
