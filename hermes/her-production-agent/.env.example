# her-production profile 的产线环境变量（install.sh 复制成 .env 后填 key）。
# .env 永不进 git（.gitignore 管着）。

# 模型网关（OpenAI 兼容）：文本走 HER_TEXT_MODEL（agent 本体在 config.yaml 里配），
# 生图走 HER_IMAGE_MODEL（scripts/her-production.sh 读这里）。
HER_API_BASE=https://newapi.yuaiweiwu.com/v1
HER_API_KEY=sk-请填你自己的网关key
HER_IMAGE_MODEL=doubao-seedream-5-0-flash

# 演练库：只允许这个 sqlite。生产库写入走 publish_release 链，归协调会话。
# HER_DRILL_DB=$HOME/.hermes/profiles/her-production/state/drill.db

# server 仓库克隆（build_her_pack.py + companion 包所在）。
HER_SERVER_REPO=/Users/gqli/work/agent-docs-rolepack-20261127/myproject/companion-agent/server

# 现成已验收分层素材（M0 演练的资产底座）。换素材只改这一行。
HER_BASE_ZIP=/Users/gqli/work/myandroidTest/.claude/worktrees/focused-mclean-1bfa86/feature-companion/src/main/assets/avatars/demo-avatar-v1.zip

# download_url 前缀（演练占位；生产 CDN 落点待定——her 包先随 APK 打包）。
HER_CDN_BASE=https://cdn.invalid/drill
