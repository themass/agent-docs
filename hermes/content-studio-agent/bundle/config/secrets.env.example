# Content Studio — 密钥单一来源（复制到 ~/.hermes/profiles/content-studio/secrets.env）
#
#   cp hermes-dev/config/secrets.env.example ~/.hermes/profiles/content-studio/secrets.env
#   # 编辑 secrets.env 后运行：
#   hermes-dev/scripts/sync-content-studio-secrets.sh
#
# secrets.env 不要提交到 git。改 key 只改这一处，再跑 sync。

# ── LLM（newapi / OpenRouter 等 OpenAI 兼容上游）────────────────────────────
# 上游根 URL，不要带 /v1（OpenInspector 会拼路径）
LLM_UPSTREAM_BASE_URL=https://newapi.yuaiweiwu.com
LLM_API_KEY=sk-your-key-here

# 本地 OpenInspector 代理（Hermes / Open Notebook 客户端应连这里，不直连上游）
LLM_PROXY_URL=http://127.0.0.1:8080/v1

# ── TTS（阿里 NLS）──────────────────────────────────────────────────────────
# TTS 不走 OpenInspector（协议不同）。密钥写在 profile 的 tts-providers.yaml。
# 路径：~/.hermes/profiles/content-studio/config/tts-providers.yaml
# 播客 TTS 经 ali-tts-proxy (:8969) 自动读同一 yaml。
