# Content Studio — 密钥单一来源（复制到 ~/.hermes/profiles/content-studio/secrets.env）
#
#   cp docs/hermes/content-studio-agent/bundle/config/secrets.env.example \
#      ~/.hermes/profiles/content-studio/secrets.env
#   # 编辑 secrets.env 后运行：
#   hermes-dev/scripts/sync-content-studio-secrets.sh
#
# secrets.env 不要提交到 git。改 key 只改这一处，再跑 sync。

# ── LLM（FreeLLMAPI 统一出口）──────────────────────────────────────────────
# 在 FreeLLMAPI Web UI（默认 http://127.0.0.1:3011）→ Keys 添加各免费 provider；
# 复制 Dashboard 里的 unified key 到 LLM_API_KEY（freellmapi-...）。
LLM_UPSTREAM_BASE_URL=http://127.0.0.1:3011
LLM_API_KEY=freellmapi-your-unified-key-here

# Hermes / Open Notebook / MPT 客户端 base_url（不经 TencentDB 时直连 FreeLLMAPI）
LLM_PROXY_URL=http://127.0.0.1:3011/v1

# 默认聊天模型（FreeLLMAPI 可用 auto 或具体模型 id）
LLM_MODEL=auto

# ── TTS（阿里 NLS）──────────────────────────────────────────────────────────
# TTS 不走 LLM 代理。密钥写在 profile 的 tts-providers.yaml。
# 路径：~/.hermes/profiles/content-studio/config/tts-providers.yaml
