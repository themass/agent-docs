# Content Studio — shared LLM routing defaults (sourced by sync-content-studio-secrets.sh).
# Override in ~/.hermes/profiles/content-studio/secrets.env (LLM_PROXY_URL / LLM_MODEL).

CONTENT_STUDIO_LLM_PROXY_URL="${CONTENT_STUDIO_LLM_PROXY_URL:-http://127.0.0.1:8080/v1}"
CONTENT_STUDIO_LLM_MODEL="${CONTENT_STUDIO_LLM_MODEL:-gpt-5-6-luna}"
