# Copy to ~/.hermes/profiles/content-studio/tdai-hermes-ids.env after registering in Memory Panel.
# Stack start + secrets sync will merge these into config.yaml model.default_headers.
#
# TDAI_CONVERSATION_ID=auto  → Hermes sets x-conversation-id per Desktop/Workspace session (recommended).
TDAI_TEAM_ID=team-xxxxxxxxxx
TDAI_AGENT_ID=agt-xxxxxxxxxx
TDAI_TASK_ID=task-xxxxxxxxxx
TDAI_CONVERSATION_ID=auto
