# Content Studio 默认端口（可被环境变量覆盖）
# 用法: source "$(dirname "$0")/ports.env"
#
# 端口冲突说明:
#   - OpenInspector LLM Proxy 使用 8080（Hermes model.base_url 指向此处）
#   - MoneyPrinterTurbo API 使用 8082（原 8080 与 OpenInspector 冲突）

OPENINSPECTOR_DIR="${OPENINSPECTOR_DIR:-/Users/gqli/work/deepagents/openinspector}"

OPENINSPECTOR_PROXY_PORT="${OPENINSPECTOR_PROXY_PORT:-8080}"
OPENINSPECTOR_API_PORT="${OPENINSPECTOR_API_PORT:-8081}"
OPENINSPECTOR_UI_PORT="${OPENINSPECTOR_UI_PORT:-5173}"

GATEWAY_PORT="${GATEWAY_PORT:-8642}"
DASHBOARD_PORT="${DASHBOARD_PORT:-9119}"
WORKSPACE_PORT="${WORKSPACE_PORT:-${PORT:-3000}}"

SURREAL_PORT="${SURREAL_PORT:-8000}"
NOTEBOOK_API_PORT="${NOTEBOOK_API_PORT:-5055}"
NOTEBOOK_FRONTEND_PORT="${NOTEBOOK_FRONTEND_PORT:-3001}"

MPT_API_PORT="${MPT_API_PORT:-8082}"
MPT_WEBUI_PORT="${MPT_WEBUI_PORT:-8501}"
MONEYPRINTER_BASE_URL="${MONEYPRINTER_BASE_URL:-http://127.0.0.1:${MPT_API_PORT}}"

# Volcengine TTS → OpenAI-compatible proxy (optional; video uses tts-providers.yaml)
VOLCENGINE_TTS_PROXY_PORT="${VOLCENGINE_TTS_PROXY_PORT:-8968}"
VOLCENGINE_TTS_PROXY_URL="${VOLCENGINE_TTS_PROXY_URL:-http://127.0.0.1:${VOLCENGINE_TTS_PROXY_PORT}}"

# Aliyun NLS TTS → OpenAI-compatible proxy (Open Notebook podcasts)
ALI_TTS_PROXY_PORT="${ALI_TTS_PROXY_PORT:-8969}"
ALI_TTS_PROXY_URL="${ALI_TTS_PROXY_URL:-http://127.0.0.1:${ALI_TTS_PROXY_PORT}}"

# Open Notebook podcast worker (Content Studio overrides)
TTS_BATCH_SIZE="${TTS_BATCH_SIZE:-1}"
CONTENT_STUDIO_PODCAST_SHORT="${CONTENT_STUDIO_PODCAST_SHORT:-1}"
NOTEBOOK_PODCAST_API_URL="${NOTEBOOK_PODCAST_API_URL:-http://127.0.0.1:${NOTEBOOK_API_PORT}}"

START_OPENINSPECTOR="${START_OPENINSPECTOR:-1}"
WORKSPACE_BACKGROUND="${WORKSPACE_BACKGROUND:-1}"
