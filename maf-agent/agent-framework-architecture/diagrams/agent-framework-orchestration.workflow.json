{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Agent Framework 编排工作流",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "orch", "label": "Workflow 图编排" },
    { "id": "agent", "label": "Agent 节点内环" }
  ],
  "nodes": [
    { "id": "start", "lane": "orch", "col": 0, "type": "frontend", "label": "启动 run" },
    { "id": "select", "lane": "orch", "col": 1, "type": "cloud", "label": "选择节点", "sublabel": "图遍历" },
    { "id": "agent_node", "lane": "agent", "col": 2, "type": "backend", "label": "Agent 节点", "sublabel": "内层 tool 循环" },
    { "id": "checkpoint", "lane": "orch", "col": 3, "type": "database", "label": "写 checkpoint", "sublabel": "WorkflowRunState" },
    { "id": "next", "lane": "orch", "col": 4, "type": "backend", "label": "下一节点?", "sublabel": "条件边" },
    { "id": "done", "lane": "orch", "col": 5, "type": "external", "label": "完成", "sublabel": "输出" }
  ],
  "edges": [
    { "id": "e1", "from": "start", "to": "select", "label": "graph run" },
    { "id": "e2", "from": "select", "to": "agent_node", "label": "激活节点", "variant": "emphasis" },
    { "id": "e3", "from": "agent_node", "to": "checkpoint", "label": "节点完成" },
    { "id": "e4", "from": "checkpoint", "to": "next", "label": "持久化" },
    { "id": "e5", "from": "next", "to": "select", "label": "还有节点", "variant": "dashed" },
    { "id": "e6", "from": "next", "to": "done", "label": "图结束" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "编排 vs 内环",
      "items": [
        "外层：workflow run 生命周期与图遍历",
        "内层：每个 agent 节点内的 model → tool 循环"
      ]
    }
  ]
}
