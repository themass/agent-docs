    { "id": "interrupt", "lane": "outer", "col": 3, "type": "security", "label": "Interrupt", "sublabel": "cancel token" },
    { "id": "spawn", "lane": "inner", "col": 2, "type": "cloud", "label": "tokio::spawn", "sublabel": "不 await" },
