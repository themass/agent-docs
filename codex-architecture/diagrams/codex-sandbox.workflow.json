    { "id": "sandbox1", "lane": "guard", "col": 3, "type": "security", "label": "Sandbox 1", "sublabel": "Seatbelt" },
    { "id": "escalate", "lane": "guard", "col": 4, "type": "cloud", "label": "attempt 2", "sublabel": "escalatable" },
